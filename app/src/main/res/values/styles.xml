<resources>
    <style name="SamsungPillButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_action_pill</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="SamsungModeChip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/bg_mode_pill_selector</item>
        <item name="android:textColor">@color/mode_chip_text_selector</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="SamsungMiniToggle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/bg_toggle_pro</item>
        <item name="android:textColor">#CFE2FF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="SamsungInputChip" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_chip</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorHint">#99C5CFDA</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProParamInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textColorHint">#80FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
